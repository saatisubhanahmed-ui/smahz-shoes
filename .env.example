# ============================================================
#  SMAHZ Shoes — environment variables
#  Fill in the values below, save the file, then run:
#     npm install
#     npm run dev
#  Restart `npm run dev` every time you change this file.
# ============================================================

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format (no +, no spaces). 0302-2059877 -> 923022059877
NEXT_PUBLIC_WHATSAPP_NUMBER=923022059877
# Store email shown on the website (Contact page, footer, "Send order on Email")
NEXT_PUBLIC_STORE_EMAIL=your-store-email@gmail.com

# ---------- Supabase ----------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# "service_role" secret key — server only, never share it
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------- Admin panel (/admin) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123
# Any long random string (used to sign the admin login cookie)
AUTH_SECRET=replace-with-a-long-random-string-9f8e7d6c5b4a

# ---------- Email notifications ----------
# Where new orders & contact-form messages are delivered
ADMIN_EMAIL=your-email@gmail.com

# Option 1: Resend  (https://resend.com -> API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Without a verified domain, Resend only allows onboarding@resend.dev as sender
# and only delivers to the email address of your Resend account.
RESEND_FROM=SMAHZ Shoes <onboarding@resend.dev>

# Option 2: Gmail  (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Which provider to try first: "resend" or "gmail".
# If the first one fails (or is not configured), the other one is used automatically.
EMAIL_PROVIDER=resend

# ---------- AI Assistant (chatbot) ----------
# Add ONE of these keys. Without any key the built-in smart assistant is used
# (it still confirms the order, collects all details and gives a tracking number).
# Option A — Google Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Option B — Anthropic Claude: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5
# auto | claude | gemini | smart
AI_PROVIDER=auto
